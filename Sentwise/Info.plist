<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Transport Security: allow plain-HTTP connections to hosts on the
	  local network (e.g. a LAN machine running Ollama or LM Studio at
	  http://192.168.x.x:11434). Loopback (http://localhost) is already exempt.
	  This does NOT enable arbitrary insecure loads — remote endpoints must
	  still be HTTPS. The remaining Info.plist keys are generated by Xcode
	  (GENERATE_INFOPLIST_FILE) and merged on top of this file at build time.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!--
	  Custom URL scheme (item 59). `sentwise://` receives two browser hand-backs:
	  the Clerk Google sign-in and OpenRouter key-provisioning round-trips.
	  The browser lands on an HTTPS page on the Worker (/auth/callback,
	  /openrouter/callback) which forwards to sentwise://oauth-callback and
	  sentwise://openrouter-callback respectively.
	  AppDelegate.application(_:open:) routes them; the Clerk dashboard must list
	  https://sentwise-inference.sentwise-service.workers.dev/auth/callback as an allowed redirect URL.
	  A QA build (item 123, Config/QA.xcconfig) registers its own scheme,
	  sentwise-qa://, and bundle-suffixed URL name so production callbacks never
	  reach it; production builds leave both suffixes empty.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tookes.Sentwise$(SENTWISE_BUNDLE_ID_SUFFIX)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sentwise$(SENTWISE_URL_SCHEME_SUFFIX)</string>
			</array>
		</dict>
	</array>

	<!--
	  Sparkle auto-update configuration.

	  SUFeedURL: the appcast the updater polls. We publish it as a release
	  asset on the "latest" GitHub release so the URL is stable across
	  versions. The release pipeline (Distribution/scripts/release.sh) writes
	  and uploads appcast.xml; see docs/releasing.md.

	  SUEnableAutomaticChecks: quiet check-on-launch. Sparkle only surfaces UI
	  when an update is actually found; the explicit "Check for Updates…" menu
	  item is the always-interactive path.

	  SUPublicEDKey: the real EdDSA public key (set 2026-08-14 for v0.1.0).
	  The matching PRIVATE key lives in the maintainer's login Keychain (never in
	  the repo); `generate_keys -p` re-prints this public half if ever needed.
	  Do not replace this public key for normal releases: installed clients
	  verify future appcasts against the key that shipped in their current app.
	-->
	<!--
	  "Sign in with Google" OAuth client (item 104). Expanded at build time from
	  Config/GoogleOAuth.xcconfig (empty in the repo, so the feature is off) or
	  its git-ignored local override / xcodebuild command-line settings. An empty
	  or placeholder value switches the feature off. See docs/gmail-oauth.md.
	-->
	<key>SentwiseGoogleOAuthClientID</key>
	<string>$(SENTWISE_GOOGLE_CLIENT_ID)</string>
	<key>SentwiseGoogleOAuthClientSecret</key>
	<string>$(SENTWISE_GOOGLE_CLIENT_SECRET)</string>

	<!--
	  Per-build configuration (item 123), read by BuildConfiguration. Expanded
	  from Config/QA.xcconfig in the QA build configuration only; Debug and
	  Release leave every value empty, which resolves to the production service,
	  Clerk instance, Paddle config, Keychain service, and data folder.
	-->
	<key>SentwiseServiceBaseURL</key>
	<string>$(SENTWISE_SERVICE_BASE_URL)</string>
	<key>SentwiseClerkFrontendAPIURL</key>
	<string>$(SENTWISE_CLERK_FRONTEND_API_URL)</string>
	<key>SentwisePaddleEnvironment</key>
	<string>$(SENTWISE_PADDLE_ENVIRONMENT)</string>
	<key>SentwisePaddleClientToken</key>
	<string>$(SENTWISE_PADDLE_CLIENT_TOKEN)</string>
	<key>SentwisePaddleStarterPriceID</key>
	<string>$(SENTWISE_PADDLE_STARTER_PRICE_ID)</string>
	<key>SentwisePaddleProPriceID</key>
	<string>$(SENTWISE_PADDLE_PRO_PRICE_ID)</string>
	<key>SentwisePaddleUnlimitedPriceID</key>
	<string>$(SENTWISE_PADDLE_UNLIMITED_PRICE_ID)</string>
	<key>SentwiseKeychainServiceSuffix</key>
	<string>$(SENTWISE_KEYCHAIN_SERVICE_SUFFIX)</string>
	<key>SentwiseAppSupportDirectoryName</key>
	<string>$(SENTWISE_APP_SUPPORT_DIRECTORY)</string>

	<key>SUFeedURL</key>
	<string>https://github.com/michaeltookes/sentwise/releases/latest/download/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUPublicEDKey</key>
	<string>juNano3Eeq4XsPnbiSyqQ0mk48luI+lIyureRMZmJnI=</string>
</dict>
</plist>
