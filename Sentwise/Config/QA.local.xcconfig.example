SENTWISE_PADDLE_STARTER_PRICE_ID = pri_YOUR_SANDBOX_STARTER
SENTWISE_PADDLE_PRO_PRICE_ID = pri_YOUR_SANDBOX_PRO
SENTWISE_PADDLE_UNLIMITED_PRICE_ID = pri_YOUR_SANDBOX_UNLIMITED
